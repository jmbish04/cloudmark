/**
 * Cloudflare Workers config for Cloudmark (Hono + React SPA).
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudmark",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // API must hit the Worker; without this, SPA fallback can swallow /api/*
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudmark",
      "database_id": "f1373741-7478-4881-9d01-ce2a4728c495",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "BASE_URL": "https://cloudmark.site",
  },
  /**
   * Custom domain — DNS for cloudmark.site must point at Cloudflare.
   * workers.dev URL remains available as a fallback.
   */
  "routes": [
    { "pattern": "cloudmark.site", "custom_domain": true },
    { "pattern": "www.cloudmark.site", "custom_domain": true },
  ],
  "secrets_store_secrets": [
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY",
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID",
    },
  ],
  "services": [
    {
      "binding": "CORE_GUARDIAN",
      "service": "core-guardian",
      "entrypoint": "GuardianRpc",
      "remote": true,
    },
  ],
}
